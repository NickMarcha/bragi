# Copy to ~/.config/bragi-client/roc-link.env and edit for THIS machine.
#
# Do NOT assume these numbers are correct for a machine other than the one
# they were captured from. The values below are sage-dev's real, currently
# live port/name assignments (from ~/.config/pipewire/pipewire.conf.d/
# 99-roc-sagepi.conf) as of 2026-08-13. sagedeck's current PipeWire config
# lives in 99-roc-test.conf / 99-roc-test-playback.conf - filenames that
# read as exploratory/test configs, not confirmed final - verify live on
# sagedeck (SSH in, read those files + `pw-dump | grep -i roc`) before
# trusting any port number here for that machine, don't just copy sage-dev's.
#
# ROC_MODULE_DIR also differs per machine - it's wherever this machine's
# locally-built libpipewire-module-roc-sink.so/-source.so ended up (the
# roc-toolkit PipeWire modules aren't distro-packaged, so this is a manual
# build dir, not a fixed path). sage-dev built into pipewire-0.3-roc;
# sagedeck's build (as of 2026-08-13) is in the differently-named
# pipewire-0.3-roc-test - check `find ~/.local/lib -iname '*roc*'` on each
# machine rather than assuming they match.

SAGEPI_TAILSCALE_IP=100.114.201.69
ROC_MODULE_DIR=/home/sage/.local/lib/pipewire-0.3-roc

# PEER_NAME must exactly match this machine's Peer.name in sagepi's
# peers.yaml (e.g. "sage-dev", "sagedeck") - it's how the dashboard's
# per-peer status dot knows which card to update when this machine's tray
# app connects/disconnects its presence heartbeat (app/peer_presence.py).
# BRAGI_WS_URL is sagepi's dashboard reachable over the tailnet via
# `tailscale serve` (confirmed 2026-08-13: tailscale serve status on
# sagepi shows https://sagepi.tail08dfa.ts.net -> 127.0.0.1:8000) - the
# app appends /<PEER_NAME> itself, don't include it here. Leaving either
# blank just disables the presence heartbeat (client_connected shows as
# unset server-side); nothing else in the app depends on these.
PEER_NAME=sage-dev
BRAGI_WS_URL=wss://sagepi.tail08dfa.ts.net/ws/peer

# roc-sink: receives sagepi's headset audio -> local playback
REMOTE_SOURCE_PORT=10031
REMOTE_REPAIR_PORT=10032
REMOTE_CONTROL_PORT=10033
LOCAL_SINK_NAME=sagepi-headset-sink2

# roc-source: captures this machine's mic -> sends to sagepi
LOCAL_SOURCE_PORT=10021
LOCAL_REPAIR_PORT=10022
LOCAL_CONTROL_PORT=10023
LOCAL_SOURCE_NAME=sagepi-mic2
SESS_LATENCY_MSEC=40
