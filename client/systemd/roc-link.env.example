# The tray app's "Connect to Bragi..." writes this file for you. This
# example is for setting the link up by hand: copy it to
# ~/.config/bragi-client/roc-link.env (client/systemd/install.sh does) and
# edit it for THIS machine.
#
# The ports and PEER_NAME come from the peer's entry on the Bragi server.
# A peer added from the dashboard gets a block of six ports; data/peers.yaml
# on the server lists them (mic_source/repair/control and
# playback_source/repair/control).

# The Bragi host's address, e.g. its Tailscale IP (`tailscale ip -4` there).
# Older installs call this SAGEPI_TAILSCALE_IP, which still works.
BRAGI_HOST_IP=100.64.0.10

# Where this machine's PipeWire Roc modules live
# (libpipewire-module-roc-sink.so / -source.so). Distro packages put them in
# /usr/lib/pipewire-0.3; a local build goes wherever you built it. Check with
# `find / -name 'libpipewire-module-roc-*' 2>/dev/null`.
ROC_MODULE_DIR=/usr/lib/pipewire-0.3

# PEER_NAME must exactly match this machine's peer name in Bragi. It's how
# the dashboard's status dot knows which card to update when this machine's
# tray app connects, and how the volume menu finds "This device".
# BRAGI_WS_URL is the Bragi dashboard's address with /ws/peer appended,
# ws:// or wss:// (the app appends /<PEER_NAME> itself). It also supplies the
# address for the volume controls and "Open web UI". Leave either blank to
# turn the presence heartbeat off.
PEER_NAME=laptop
BRAGI_WS_URL=wss://bragi.example.ts.net/ws/peer

# BRAGI_API_KEY is only needed once Bragi's web UI has a password: the
# volume window then needs a key to use the dashboard's controls socket.
# Make one in the dashboard under Security > API connections.
# BRAGI_API_KEY=bragi_...

# roc-sink: a local output device. Whatever plays into it is sent to the
# Bragi host and mixed into its headset. These are the peer's playback_*
# ports, where the host listens.
REMOTE_SOURCE_PORT=10044
REMOTE_REPAIR_PORT=10045
REMOTE_CONTROL_PORT=10046
LOCAL_SINK_NAME=bragi-headset-sink

# roc-source: a local input device carrying the Bragi host's headset mic.
# These are the peer's mic_* ports, where the host sends to.
LOCAL_SOURCE_PORT=10041
LOCAL_REPAIR_PORT=10042
LOCAL_CONTROL_PORT=10043
LOCAL_SOURCE_NAME=bragi-mic
SESS_LATENCY_MSEC=40
