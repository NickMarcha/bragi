# Copy to .env and change what differs on your host. All optional.

# The user running PipeWire (`id -u` / `id -g`).
# BRAGI_UID=1000
# BRAGI_GID=1000

# The host's input group, for the headset volume knob (`getent group input`).
# INPUT_GID=996

# Where Bragi keeps peers.yaml, peers.conf and its other state. The host
# units in host/systemd/ watch ~/.local/share/bragi/data, so change this
# only if you change those too.
# BRAGI_DATA=/home/pi/.local/share/bragi/data

# Port on 127.0.0.1 for the web UI. Put tailscale serve or a reverse proxy
# in front of it.
# BRAGI_PORT=8000
