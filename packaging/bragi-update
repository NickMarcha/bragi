#!/bin/bash
# Bragi's updater, run as root by bragi-update.service. Bragi itself runs as
# a user and can't use apt; it writes "check" or "upgrade" into
# /var/lib/bragi/update-request, bragi-update.path starts this, and this
# writes what it found to /var/lib/bragi/update.json for the dashboard.
# A daily timer runs a check too.
#
# It only ever upgrades the packages listed here, from the configured apt
# sources (Bragi's repository is signed).
set -uo pipefail

STATE=/var/lib/bragi
REQUEST="$STATE/update-request"
STATUS="$STATE/update.json"
PACKAGES="bragi deskflow"

# A request written while this runs doesn't start another run (the path
# unit ignores changes while the service is active), so remember the
# request file as it was and look again at the end.
seen="$(stat -c %y "$REQUEST" 2>/dev/null || true)"

action="${1:-}"
if [[ -z "$action" && -f "$REQUEST" ]]; then
    # Left as it is: emptying it would be a change the path unit sees, and
    # start another run. Each request writes it anew.
    action="$(tr -dc 'a-z' < "$REQUEST" | head -c 16)"
fi
case "$action" in
    check|upgrade) ;;
    *) action=check ;;
esac

versions() {  # one JSON object: package -> {installed, candidate}
    local first=1
    printf '{'
    for pkg in $PACKAGES; do
        local installed candidate
        installed="$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null || true)"
        candidate="$(apt-cache policy "$pkg" 2>/dev/null | awk '/Candidate:/ {print $2; exit}')"
        [[ "$candidate" == "(none)" ]] && candidate=""
        [[ $first -eq 1 ]] || printf ','
        first=0
        printf '"%s":{"installed":"%s","candidate":"%s"}' "$pkg" "$installed" "$candidate"
    done
    printf '}'
}

write_status() {  # state, message
    local tmp="$STATUS.tmp"
    local message="${2//\"/\'}"
    printf '{"state":"%s","action":"%s","message":"%s","at":%s,"packages":%s}\n' \
        "$1" "$action" "${message//$'\n'/ }" "$(date +%s)" "$(versions)" > "$tmp"
    chmod 644 "$tmp"
    mv -f "$tmp" "$STATUS"
}

case "$action" in check) write_status running checking ;; *) write_status running upgrading ;; esac
if ! out="$(apt-get update -q 2>&1)"; then
    write_status failed "apt-get update failed: $(echo "$out" | grep -E '^(E|W):' | head -3)"
    exit 1
fi

if [[ "$action" == upgrade ]]; then
    upgradable=""
    for pkg in $PACKAGES; do
        dpkg-query -W "$pkg" >/dev/null 2>&1 && upgradable="$upgradable $pkg"
    done
    deskflow_before="$(dpkg-query -W -f='${Version}' deskflow 2>/dev/null || true)"
    # Bragi's postinst restarts Bragi on the new code, so the dashboard
    # reconnects to a new version while this finishes.
    # shellcheck disable=SC2086
    if ! out="$(DEBIAN_FRONTEND=noninteractive apt-get install -y -q --only-upgrade \
            -o Dpkg::Options::=--force-confold $upgradable 2>&1)"; then
        write_status failed "upgrade failed: $(echo "$out" | grep -E '^(E|W):' | head -3)"
        exit 1
    fi
    # Deskflow's package doesn't restart the headless server (a user unit),
    # so it would keep running the old binary. Restart it where it runs;
    # try-restart leaves it alone for users who don't run it.
    message="upgraded"
    deskflow_after="$(dpkg-query -W -f='${Version}' deskflow 2>/dev/null || true)"
    if [[ -n "$deskflow_after" && "$deskflow_after" != "$deskflow_before" ]]; then
        for user in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
            systemctl --user -M "$user@" try-restart deskflow-headless.service 2>/dev/null || true
        done
        message="upgraded; Deskflow restarted on $deskflow_after"
    fi
    write_status done "$message"
else
    write_status done "checked"
fi

if [[ -f "$REQUEST" && "$(stat -c %y "$REQUEST" 2>/dev/null)" != "$seen" ]]; then
    exec "$BASH" "$0"
fi
