[Unit]
Description=Bragi: the desk hub (audio, KVM, controllers, Bluetooth)
Documentation=https://github.com/NickMarcha/bragi/blob/main/docs/deployment.md
# Bragi talks to the user's PipeWire; it starts without it, the audio
# module is then off until it appears.
After=pipewire.service wireplumber.service

[Service]
Environment=BRAGI_DATA_DIR=%h/.local/share/bragi/data
# The tray apps' peer socket on the LAN, for when Tailscale is down
# (app/lan_peer.py): TLS with a pinned certificate and a token per computer.
Environment=BRAGI_LAN_PEER_PORT=8443
WorkingDirectory=/opt/bragi
ExecStart=/opt/bragi/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
